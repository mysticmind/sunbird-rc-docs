import { defineConfig } from 'vitepress'
import container from 'markdown-it-container'
import { tabsMarkdownPlugin } from 'vitepress-plugin-tabs'
import llmstxt, { copyOrDownloadAsMarkdownButtons } from 'vitepress-plugin-llms'
import sidebar from './sidebar.json'

// Placeholder until the docs repo exists on GitHub.
const REPO = 'https://github.com/Sunbird-RC/docs'
const BRANCH = 'main'

// Simple wrappers for the GitBook blocks that VitePress has no equivalent for.
const wrappers: Record<string, string> = {
  steps: 'rc-steps',
  step: 'rc-step',
  columns: 'rc-columns',
  column: 'rc-column',
  card: 'rc-card',
}

export default defineConfig({
  title: 'Sunbird RC',
  description: 'Build live, reusable and trustworthy registries and verifiable credentials, with configuration, not code.',
  lang: 'en-US',
  cleanUrls: true,
  lastUpdated: true,
  srcExclude: ['README.md', 'CONTRIBUTING.md'],
  ignoreDeadLinks: 'localhostLinks',
  head: [
    ['link', { rel: 'icon', type: 'image/svg+xml', href: '/favicon.svg' }],
    ['link', { rel: 'icon', type: 'image/png', sizes: '32x32', href: '/favicon-32.png' }],
    ['link', { rel: 'apple-touch-icon', sizes: '180x180', href: '/apple-touch-icon.png' }],
  ],

  markdown: {
    config(md) {
      // ```mermaid blocks become diagrams, rendered in the browser by the Mermaid component
      const fence = md.renderer.rules.fence!
      md.renderer.rules.fence = (tokens, idx, options, env, self) => {
        const token = tokens[idx]
        if (token.info.trim() === 'mermaid') {
          return `<Mermaid code="${encodeURIComponent(token.content)}" />`
        }
        return fence(tokens, idx, options, env, self)
      }
      md.use(tabsMarkdownPlugin)
      // "Copy page" button and dropdown (view / download as Markdown, open in an AI assistant) under each page title
      md.use(copyOrDownloadAsMarkdownButtons)
      for (const [name, cls] of Object.entries(wrappers)) {
        md.use(container, name, {
          render: (tokens: any[], idx: number) =>
            tokens[idx].nesting === 1 ? `<div class="${cls}">\n` : '</div>\n',
        })
      }
    },
  },

  vite: {
    plugins: [llmstxt({ domain: 'https://rc.sunbird.org' })],
  },

  themeConfig: {
    logo: { src: '/logo-rc.svg', alt: 'Sunbird RC' },
    siteTitle: false,
    nav: [
      { text: 'Guide', link: '/learn/readme', activeMatch: '^/(learn|use|engage|help)/' },
      { text: 'Registry', link: '/registry/technical-overview/high-level-architecture', activeMatch: '^/registry/' },
      { text: 'Credentials', link: '/credentials/technical-overview/high-level-architecture', activeMatch: '^/credentials/' },
      {
        text: 'Releases',
        items: [
          { text: 'Registry releases', link: '/use/releases/registry' },
          { text: 'Credentialing releases', link: '/use/releases/credentialing' },
        ],
      },
      // Index of every page for AI agents and LLM tools (generated by vitepress-plugin-llms)
      { text: 'LLM Friendly Docs', link: '/llms.txt', target: '_blank' },
      // The wider Sunbird family of Digital Public Goods
      { text: 'sunbird.org', link: 'https://www.sunbird.org/' },
    ],
    sidebar,
    socialLinks: [{ icon: 'github', link: 'https://github.com/Sunbird-RC/sunbird-rc-core' }],
    search: { provider: 'local' },
    outline: { level: [2, 3] },
    editLink: {
      pattern: `${REPO}/edit/${BRANCH}/:path`,
      text: 'Edit this page on GitHub',
    },
    footer: {
      message: 'Released under the <a href="https://github.com/Sunbird-RC/sunbird-rc-core/blob/main/LICENSE" target="_blank" rel="noopener">MIT License</a>.',
      // Copyright on two balanced lines: who holds it, then on whose behalf
      copyright:
        `Copyright © ${new Date().getFullYear()} `
        + '<a href="https://www.iiitb.ac.in/" target="_blank" rel="noopener">International Institute of Information Technology, Bangalore (IIITB)</a>'
        + '<br>on behalf of the <a href="https://www.coss.org.in/" target="_blank" rel="noopener">Centre for Open Societal Systems (COSS)</a>',
    },
  },
})
